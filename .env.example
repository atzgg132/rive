DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
APP_URL="http://localhost:3000"
APP_ENV="local"
DEPLOYMENT_VERSION="local"
DATABASE_POOL_MAX="10"
DATABASE_SSL_REJECT_UNAUTHORIZED="false"
# Set this to the original RDS hostname when DATABASE_URL connects through a
# local SSM tunnel.
DATABASE_SSL_SERVERNAME=""
SESSION_SECRET="replace-with-a-long-random-secret"
CALENDAR_ENCRYPTION_KEY="base64-encoded-32-byte-key"
CRON_SECRET="replace-with-a-separate-long-random-secret"

# Google Calendar OAuth (web application credentials).
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""

# Zoho Books server-based OAuth application.
ZOHO_BOOKS_CLIENT_ID=""
ZOHO_BOOKS_CLIENT_SECRET=""
ZOHO_ACCOUNTS_URL="https://accounts.zoho.in"

# Transactional email. Paid Zoho organization accounts normally use
# smtppro.zoho.in:465 with SSL for Rive's Indian Zoho data centre. Always use
# the exact server shown in Zoho Mail's
# Server Configuration Details and an app password when MFA is enabled.
EMAIL_PROVIDER="zoho"
SMTP_HOST="smtppro.zoho.in"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="hello@rive.work"
SMTP_PASS=""
EMAIL_FROM='"rive." <hello@rive.work>'
EMAIL_REPLY_TO="hello@rive.work"

# AWS production services.
AWS_REGION="ap-south-1"
SES_CONFIGURATION_SET=""
ASSET_BUCKET=""
ASSET_PUBLIC_BASE_URL=""
MIGRATION_QUEUE_URL=""
MAX_UPLOAD_BYTES="10485760"
