DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
APP_URL="http://localhost:3000"
APP_ENV="local"
DEPLOYMENT_VERSION="local"
DATABASE_POOL_MAX="10"
DATABASE_SSL_REJECT_UNAUTHORIZED="false"
# Set this to the original RDS hostname when DATABASE_URL connects through a
# local SSM tunnel.
DATABASE_SSL_SERVERNAME=""
SESSION_SECRET="replace-with-a-long-random-secret"
CALENDAR_ENCRYPTION_KEY="base64-encoded-32-byte-key"
CRON_SECRET="replace-with-a-separate-long-random-secret"

# Agreements / recorded acceptance. 'rive' is the first-party open-beta adapter;
# use 'local' only for isolated development smoke tests.
CONTRACTS_ENABLED="true"
ESIGN_PROVIDER="local"
CONTRACTS_RECORDED_ACCEPTANCE_ENABLED="true"
# Development/demo provider is rejected in production unless explicitly enabled.
CONTRACTS_ALLOW_LOCAL_PROVIDER_IN_PRODUCTION="false"
ESIGN_WEBHOOK_SECRET="replace-with-a-provider-specific-webhook-secret"

# Google OAuth web application credentials. Sign in with Google uses the same
# client whenever these are set. Deployed environments set GOOGLE_CALENDAR_ENABLED
# true so Calendar connect is available; keep it false locally without credentials.
GOOGLE_CALENDAR_ENABLED="false"
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""

# Zoho Books server-based OAuth application.
ZOHO_BOOKS_ENABLED="false"
ZOHO_BOOKS_CLIENT_ID=""
ZOHO_BOOKS_CLIENT_SECRET=""
ZOHO_ACCOUNTS_URL="https://accounts.zoho.in"

# Transactional email. Use 'console' for local development; verification links
# are printed by the server. Google Workspace authenticated SMTP uses
# smtp.gmail.com:587 with STARTTLS and an app password when 2-Step
# Verification is enabled. Keep the From address aligned with the account.
EMAIL_PROVIDER="console"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="hello@rive.work"
SMTP_PASS=""
EMAIL_FROM='"rive." <hello@rive.work>'
EMAIL_REPLY_TO="hello@rive.work"

# AWS production services.
AWS_REGION="ap-south-1"
SES_CONFIGURATION_SET=""
ASSET_BUCKET=""
ASSET_PUBLIC_BASE_URL=""
MIGRATION_QUEUE_URL=""
MAX_UPLOAD_BYTES="10485760"
# Hard ceiling for portfolio video, audio, and document uploads. Per-format
# caps are set in src/utils/portfolioMedia.ts; this bounds all of them.
MAX_MEDIA_UPLOAD_BYTES="157286400"

# How many proxies in front of the app append to X-Forwarded-For. The client
# address is read that many hops from the right, which is what stops a caller
# from forging it and getting a fresh rate-limit bucket per request.
# 0 is correct for the current topology: Caddy on the same host is the only
# proxy, and it overwrites the header. Put a CDN in front and this becomes 1.
# Getting this too high is safe (it falls back to the rightmost entry); too low
# is also safe (it reads a hop closer to the proxy). Only raise it when you have
# actually added a trusted proxy.
TRUSTED_PROXY_HOPS="0"

# Migration engine (CSV/XLSX import of clients, projects, invoices, expenses).
# While this is false the original onboarding importer remains the only import
# path, which keeps the rollback story to a single flag.
MIGRATION_ENGINE_ENABLED="false"

# Admin portal credentials. Generate password hash with: node scripts/setup-admin.mjs
ADMIN_USERNAME="Admin1"
ADMIN_PASSWORD_HASH="scrypt:rive-admin-bootstrap-salt:a081a3dcd120cf64dfed4441573bb3fc3141b8ca921be594ad2d41bc3dd4e863dd7137f49c5afeb8f7de098b860c72c61f5610693ba5d6f24b0a9d2d3c7c1bf8"
