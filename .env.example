DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
APP_URL="http://localhost:3000"
APP_ENV="local"
DEPLOYMENT_VERSION="local"
DATABASE_POOL_MAX="10"
DATABASE_SSL_REJECT_UNAUTHORIZED="false"
SESSION_SECRET="replace-with-a-long-random-secret"
CALENDAR_ENCRYPTION_KEY="base64-encoded-32-byte-key"
CRON_SECRET="replace-with-a-separate-long-random-secret"

# Google Calendar OAuth (web application credentials).
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""

# Transactional email. Use your provider's SMTP credentials.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM='"rive." <hello@rive.work>'
EMAIL_REPLY_TO="hello@rive.work"

# AWS production services. Leave EMAIL_PROVIDER=smtp for local SMTP development.
AWS_REGION="ap-south-1"
EMAIL_PROVIDER="smtp"
SES_CONFIGURATION_SET=""
ASSET_BUCKET=""
ASSET_PUBLIC_BASE_URL=""
MAX_UPLOAD_BYTES="10485760"
