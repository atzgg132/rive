# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*

# testing
/coverage
/playwright-report/
/test-results/
/blob-report/

# next.js
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# env files (opt in explicitly)
.env*
!.env.example

# generated code graph — rebuild with `graphify update .`
graphify-out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*

# vercel
.vercel

# editor / agent tooling
.cursor/
.hermes/
*.swp

# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
!*.tfvars.example
infrastructure/aws/.build/*.zip

# Bytecode from running the Lambda job runner locally. archive_file packages
# job_runner.py from source, so this is never an input to a deploy.
__pycache__/
*.pyc
