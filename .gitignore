# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/blob-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
.env.launch-film

# launch film: auth, generated captures, audio drafts, and renders stay local
video/launch-film/.auth/
video/launch-film/renders/
video/launch-film/captures/
video/launch-film/public/captures/
video/launch-film/audio/generated/
video/launch-film/audio/mix/
video/launch-film/out/
video/launch-film/node_modules/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# server specific
server/.env
server/dist/

# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
!*.tfvars.example
infrastructure/aws/.build/*.zip

# Bytecode from running the Lambda job runner locally. archive_file packages
# job_runner.py from source, so this is never an input to a deploy.
__pycache__/
*.pyc
