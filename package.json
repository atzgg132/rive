{
  "name": "zeno",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:aws": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-aws.ps1",
    "db:migrate:aws": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-aws.ps1 -Action migrate",
    "db:migrate:status:aws": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-aws.ps1 -Action status",
    "contracts:smoke:aws": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-aws.ps1 -Action smoke",
    "contracts:cleanup-smoke:aws": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-aws.ps1 -Action cleanup-smoke",
    "migration:smoke:aws": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-aws.ps1 -Action migration-smoke",
    "migration:e2e:aws": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-aws.ps1 -Action migration-e2e",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test:domain": "node --experimental-strip-types --import ./tests/helpers/module-loader.mjs --test tests/domain/*.test.mjs",
    "test": "npm run test:e2e",
    "test:unit": "node --experimental-strip-types --import ./tests/helpers/module-loader.mjs --test tests/domain/*.test.mjs",
    "test:e2e": "playwright test",
    "start:e2e": "node scripts/start-e2e-server.mjs",
    "test:visual": "playwright test tests/e2e/visual-regression.spec.ts",
    "test:integration": "playwright test tests/e2e/release-critical.spec.ts",
    "test:e2e:headed": "playwright test --headed",
    "check": "npm run lint && npm run test:e2e && npm run build",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "email:verify": "node --env-file=.env.local scripts/verify-email.mjs",
    "db:seed:freelancer-demo": "node --env-file=.env.local scripts/seed-freelancer-demo.mjs",
    "db:seed:portfolio-media:aws": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-aws.ps1 -Action seed-portfolio",
    "analytics:backfill": "node scripts/backfill-product-events.mjs",
    "analytics:diagnose": "node --experimental-strip-types --import ./scripts/diagnose-loader.mjs --env-file=.env.local scripts/diagnose-funnel-user.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1097.0",
    "@aws-sdk/client-sqs": "^3.1097.0",
    "@aws-sdk/client-sesv2": "^3.1097.0",
    "@aws-sdk/s3-request-presigner": "^3.1097.0",
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.9.1",
    "@react-pdf/renderer": "^4.5.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.24.0",
    "motion": "^13.1.1",
    "next": "^16.2.12",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-easy-crop": "^6.2.3",
    "read-excel-file": "^6.0.1",
    "recharts": "^3.9.2",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@next/env": "^16.2.12",
    "@playwright/test": "^1.62.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "postcss": "8.5.24",
    "prisma": "^7.9.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "nanoid": "3.3.18",
    "minimatch": "10.2.6",
    "postcss": "$postcss",
    "sharp": "0.35.3",
    "deepmerge-ts": "8.0.1",
    "mysql2": "3.24.3",
    "fast-uri": "3.1.6",
    "@xmldom/xmldom": "0.8.15"
  }
}
