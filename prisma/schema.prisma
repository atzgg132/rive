  projectId                String?                     @map("project_id")
  project                  Project?                    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title                    String
  status                   String                      @default("draft")
  provider                 String                      @default("local")
  providerEnvelopeId       String?                     @map("provider_envelope_id")
  governingLaw             String                      @default("India") @map("governing_law")
  jurisdiction             String?
  currency                 String                      @default("USD")
  reviewExpiresAt          DateTime?                   @map("review_expires_at")
  finalizedAt              DateTime?                   @map("finalized_at")
  executedAt               DateTime?                   @map("executed_at")
  voidedAt                 DateTime?                   @map("voided_at")
  voidRequestedAt          DateTime?                   @map("void_requested_at")
  voidRequestedByRole      String?                     @map("void_requested_by_role")
  voidRequestNote          String?                     @map("void_request_note")
  voidConfirmNote          String?                     @map("void_confirm_note")
  createdAt                DateTime                    @default(now()) @map("created_at")
