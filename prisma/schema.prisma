datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Waitlist {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  type      String
  status    String   @default("pending")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@map("waitlist")
}

model PageView {
  id             Int      @id @default(autoincrement())
  path           String
  referrer       String?
  referrerDomain String?  @map("referrer_domain")
  userAgent      String?  @map("user_agent")
  anonymousId    String?  @map("anonymous_id")
  sessionId      String?  @map("session_id")
  userId         String?  @map("user_id")
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  utmSource      String?  @map("utm_source")
  utmMedium      String?  @map("utm_medium")
  utmCampaign    String?  @map("utm_campaign")
  landingPath    String?  @map("landing_path")
  visitedAt      DateTime @default(now()) @map("visited_at")

  @@index([visitedAt])
  @@index([anonymousId, visitedAt])
  @@index([userId, visitedAt])
  @@index([utmSource, visitedAt])
  @@map("page_views")
}

model User {
  id                          String                    @id @default(uuid())
  email                       String                    @unique
  name                        String?
  avatarUrl                   String?                   @map("avatar_url")
  passwordHash                String                    @map("password_hash")
  googleSubject               String?                   @unique @map("google_subject")
  sessionVersion              Int                       @default(0) @map("session_version")
  plan                        String                    @default("free")
  emailVerifiedAt             DateTime?                 @map("email_verified_at")
  emailVerificationRequiredAt DateTime?                 @map("email_verification_required_at")
  accountType                 String                    @default("customer") @map("account_type")
  onboardingStatus            String                    @default("complete") @map("onboarding_status")
  onboardingStep              Int                       @default(0) @map("onboarding_step")
  businessType                String?                   @map("business_type")
  businessTypes               String[]                  @default([]) @map("business_types")
  profession                  String?
  currency                    String                    @default("USD")
  displayCurrency             String                    @default("USD") @map("display_currency")
  timeZone                    String                    @default("UTC") @map("time_zone")
  onboardingData              Json?                     @map("onboarding_data")
  createdAt                   DateTime                  @default(now()) @map("created_at")
  updatedAt                   DateTime                  @updatedAt @map("updated_at")
  clients                     Client[]
  projects                    Project[]
  invoices                    Invoice[]
  expenses                    Expense[]
  portfolio                   Portfolio?
  portfolioAssets             PortfolioAsset[]
  portfolioInquiries          PortfolioInquiry[]
  authTokens                  AuthToken[]
  calendars                   Calendar[]
  calendarEvents              CalendarEvent[]
  calendarConnections         CalendarConnection[]
  calendarSubscriptions       CalendarSubscription[]
  tasks                       Task[]
  importJobs                  ImportJob[]
  importMappings              ImportMapping[]
  connectorConnections        ConnectorConnection[]
  syncRuns                    SyncRun[]
  auditEvents                 AuditEvent[]
  contracts                   Contract[]
  contractSigners             ContractSigner[]          @relation("ContractSignerUser")
  contractEvents              ContractEvent[]           @relation("ContractEventActor")
  contractComments            ContractComment[]         @relation("ContractCommentAuthor")
  notifications               Notification[]
  migrationEvents             MigrationEvent[]
  pageViews                   PageView[]
  productEvents               ProductEvent[]
  projectGenerationRecords    ProjectGenerationRecord[]
  feedback                    Feedback[]
  feedbackPromptStates        FeedbackPromptState[]
  attribution                 UserAttribution?
  invoiceProfile              InvoiceProfile?
  invoiceNumberSequence       InvoiceNumberSequence?

  @@map("users")
}

model AuthToken {
  id        String    @id @default(uuid())
  userId    String?   @map("user_id")
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  type      String
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([email, type, createdAt])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model EmailOutbox {
  id               String    @id @default(uuid())
  recipient        String
  type             String
  encryptedPayload String    @map("encrypted_payload")
  status           String    @default("queued")
  attempts         Int       @default(0)
  availableAt      DateTime  @default(now()) @map("available_at")
  lastError        String?   @map("last_error")
  processedAt      DateTime? @map("processed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([status, availableAt])
  @@index([recipient, type, createdAt])
  @@map("email_outbox")
}

model AdminSession {
  id         String    @id @default(uuid())
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  lastSeenAt DateTime? @map("last_seen_at")
  revokedAt  DateTime? @map("revoked_at")
  ipHash     String?   @map("ip_hash")
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([expiresAt, revokedAt])
  @@map("admin_sessions")
}

model UserAttribution {
  id                    String   @id @default(uuid())
  userId                String   @unique @map("user_id")
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstTouchSource      String?  @map("first_touch_source")
  firstTouchMedium      String?  @map("first_touch_medium")
  firstTouchCampaign    String?  @map("first_touch_campaign")
  firstTouchReferrer    String?  @map("first_touch_referrer")
  firstTouchLandingPage String?  @map("first_touch_landing_page")
  lastTouchSource       String?  @map("last_touch_source")
  lastTouchMedium       String?  @map("last_touch_medium")
  lastTouchCampaign     String?  @map("last_touch_campaign")
  lastTouchReferrer     String?  @map("last_touch_referrer")
  lastTouchLandingPage  String?  @map("last_touch_landing_page")
  referralSource        String?  @map("referral_source")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@index([firstTouchSource, createdAt])
  @@index([lastTouchSource, createdAt])
  @@map("user_attributions")
}

model InvoiceProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique @map("user_id")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName        String?  @map("business_name")
  contactName         String?  @map("contact_name")
  email               String?
  phone               String?
  address             String?
  taxId               String?  @map("tax_id")
  logoUrl             String?  @map("logo_url")
  defaultCurrency     String   @default("USD") @map("default_currency")
  invoicePrefix       String   @default("INV") @map("invoice_prefix")
  paymentInstructions String?  @map("payment_instructions")
  defaultTerms        String?  @map("default_terms")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("invoice_profiles")
}

model InvoiceNumberSequence {
  id         String   @id @default(uuid())
  userId     String   @unique @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prefix     String   @default("INV")
  nextNumber Int      @default(1) @map("next_number")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("invoice_number_sequences")
}

model ProductEvent {
  id            String   @id @default(uuid())
  userId        String?  @map("user_id")
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  anonymousId   String?  @map("anonymous_id")
  sessionId     String?  @map("session_id")
  eventName     String   @map("event_name")
  eventVersion  Int      @default(1) @map("event_version")
  schemaVersion Int      @default(1) @map("schema_version")
  occurredAt    DateTime @default(now()) @map("occurred_at")
  environment   String   @default("local")
  module        String?
  entityType    String?  @map("entity_type")
  entityId      String?  @map("entity_id")
  dataOrigin    String?  @map("data_origin")
  source        String?
  requestId     String?  @map("request_id")
  dedupeKey     String?  @unique @map("dedupe_key")
  properties    Json?

  @@index([userId, occurredAt])
  @@index([anonymousId, occurredAt])
  @@index([eventName, occurredAt])
  @@index([environment, occurredAt])
  @@index([module, occurredAt])
  @@map("product_events")
}

model ProductEventIssue {
  id            String   @id @default(uuid())
  eventName     String   @map("event_name")
  eventVersion  Int      @default(1) @map("event_version")
  schemaVersion Int      @default(1) @map("schema_version")
  environment   String
  userId        String?  @map("user_id")
  anonymousId   String?  @map("anonymous_id")
  requestId     String?  @map("request_id")
  reason        String
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([environment, createdAt])
  @@index([eventName, createdAt])
  @@map("product_event_issues")
}

model Feedback {
  id             String   @id @default(uuid())
  userId         String?  @map("user_id")
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  anonymousId    String?  @map("anonymous_id")
  promptKey      String?  @map("prompt_key")
  feedbackType   String   @default("general") @map("feedback_type")
  module         String?
  triggerEvent   String?  @map("trigger_event")
  rating         Int?
  body           String?
  contactAllowed Boolean  @default(false) @map("contact_allowed")
  status         String   @default("new")
  tags           String[] @default([])
  context        Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([module, createdAt])
  @@map("feedback")
}

model FeedbackPromptState {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  promptKey    String    @map("prompt_key")
  shownAt      DateTime? @map("shown_at")
  dismissedAt  DateTime? @map("dismissed_at")
  snoozedUntil DateTime? @map("snoozed_until")
  respondedAt  DateTime? @map("responded_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([userId, promptKey])
  @@index([userId, snoozedUntil])
  @@map("feedback_prompt_states")
}

model EmailDelivery {
  id                String   @id @default(uuid())
  recipient         String
  type              String
  status            String
  providerMessageId String?  @map("provider_message_id")
  error             String?
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([recipient, type, createdAt])
  @@index([status, createdAt])
  @@map("email_deliveries")
}

model Client {
  id                 String             @id @default(uuid())
  userId             String             @map("user_id")
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  email              String?
  phone              String?
  company            String?
  website            String?
  address            String?
  avatarColor        String?            @map("avatar_color")
  notes              String?
  tags               String[]
  status             String             @default("active")
  dataOrigin         String?            @map("data_origin")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  projects           Project[]
  invoices           Invoice[]
  contracts          Contract[]
  portfolioInquiries PortfolioInquiry[]
  contractSigners    ContractSigner[]   @relation("ContractSignerClient")

  @@index([userId, createdAt])
  @@index([userId, status])
  @@map("clients")
}

model Project {
  id                    String                    @id @default(uuid())
  userId                String                    @map("user_id")
  user                  User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId              String?                   @map("client_id")
  client                Client?                   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  title                 String
  description           String?
  status                String                    @default("active")
  priority              String                    @default("medium")
  startDate             DateTime?                 @map("start_date")
  dueDate               DateTime?                 @map("due_date")
  completedAt           DateTime?                 @map("completed_at")
  sourceInquiryId       String?                   @unique @map("source_inquiry_id")
  sourceInquiry         PortfolioInquiry?         @relation("PortfolioInquiryProject", fields: [sourceInquiryId], references: [id], onDelete: SetNull)
  budget                Decimal?                  @db.Decimal(12, 2)
  currency              String                    @default("USD")
  contractCoverage      String                    @default("undecided") @map("contract_coverage")
  externalContractLabel String?                   @map("external_contract_label")
  externalContractUrl   String?                   @map("external_contract_url")
  contractDecisionAt    DateTime?                 @map("contract_decision_at")
  dataOrigin            String?                   @map("data_origin")
  tags                  String[]
  createdAt             DateTime                  @default(now()) @map("created_at")
  updatedAt             DateTime                  @updatedAt @map("updated_at")
  milestones            Milestone[]
  tasks                 Task[]
  invoices              Invoice[]
  expenses              Expense[]
  contracts             Contract[]
  generationRecords     ProjectGenerationRecord[]

  @@index([userId, createdAt])
  @@index([userId, status, dueDate])
  @@index([userId, contractCoverage])
  @@index([clientId])
  @@map("projects")
}

model Milestone {
  id                       String                    @id @default(uuid())
  projectId                String                    @map("project_id")
  project                  Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title                    String
  dueDate                  DateTime?                 @map("due_date")
  completed                Boolean                   @default(false)
  completedAt              DateTime?                 @map("completed_at")
  createdAt                DateTime                  @default(now()) @map("created_at")
  tasks                    Task[]
  contractPaymentPlanItems ContractPaymentPlanItem[]

  @@index([projectId, dueDate])
  @@map("milestones")
}

model Task {
  id               String            @id @default(uuid())
  userId           String            @map("user_id")
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId        String?           @map("project_id")
  project          Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId      String?           @map("milestone_id")
  milestone        Milestone?        @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  title            String
  description      String?
  status           String            @default("todo")
  priority         String            @default("medium")
  dueDate          DateTime?         @map("due_date")
  scheduledStartAt DateTime?         @map("scheduled_start_at")
  scheduledEndAt   DateTime?         @map("scheduled_end_at")
  timeZone         String?           @map("time_zone")
  estimatedMinutes Int?              @map("estimated_minutes")
  billable         Boolean           @default(false)
  completedAt      DateTime?         @map("completed_at")
  sourceInquiryId  String?           @unique @map("source_inquiry_id")
  sourceInquiry    PortfolioInquiry? @relation("PortfolioInquiryTask", fields: [sourceInquiryId], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  @@index([userId, status, dueDate])
  @@index([projectId])
  @@index([sourceInquiryId])
  @@map("tasks")
}

model Calendar {
  id                String             @id @default(uuid())
  userId            String             @map("user_id")
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  color             String             @default("#2563EB")
  timeZone          String             @default("UTC") @map("time_zone")
  isDefault         Boolean            @default(false) @map("is_default")
  isVisible         Boolean            @default(true) @map("is_visible")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  events            CalendarEvent[]
  externalCalendars ExternalCalendar[]

  @@index([userId, isDefault])
  @@map("calendars")
}

model CalendarEvent {
  id                String                 @id @default(uuid())
  userId            String                 @map("user_id")
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendarId        String                 @map("calendar_id")
  calendar          Calendar               @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  location          String?
  meetingUrl        String?                @map("meeting_url")
  startAt           DateTime?              @map("start_at")
  endAt             DateTime?              @map("end_at")
  startDate         String?                @map("start_date")
  endDate           String?                @map("end_date")
  allDay            Boolean                @default(false) @map("all_day")
  timeZone          String                 @default("UTC") @map("time_zone")
  availability      String                 @default("busy")
  visibility        String                 @default("default")
  status            String                 @default("confirmed")
  recurrenceRule    String?                @map("recurrence_rule")
  recurringMasterId String?                @map("recurring_master_id")
  source            String                 @default("native")
  dataOrigin        String?                @map("data_origin")
  sourceRevision    Int                    @default(1) @map("source_revision")
  clientId          String?                @map("client_id")
  projectId         String?                @map("project_id")
  milestoneId       String?                @map("milestone_id")
  taskId            String?                @map("task_id")
  invoiceId         String?                @map("invoice_id")
  linkBehavior      String?                @map("link_behavior")
  deletedAt         DateTime?              @map("deleted_at")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")
  externalMappings  ExternalEventMapping[]

  @@index([userId, startAt])
  @@index([userId, startDate])
  @@index([calendarId, deletedAt])
  @@index([projectId])
  @@index([userId, dataOrigin, createdAt])
  @@index([taskId])
  @@map("calendar_events")
}

model CalendarConnection {
  id                        String                   @id @default(uuid())
  userId                    String                   @map("user_id")
  user                      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider                  String
  providerAccountId         String                   @map("provider_account_id")
  accountEmail              String?                  @map("account_email")
  encryptedCredentials      String                   @map("encrypted_credentials")
  scopes                    String[]
  status                    String                   @default("connected")
  defaultExternalCalendarId String?                  @map("default_external_calendar_id")
  lastSyncedAt              DateTime?                @map("last_synced_at")
  lastError                 String?                  @map("last_error")
  createdAt                 DateTime                 @default(now()) @map("created_at")
  updatedAt                 DateTime                 @updatedAt @map("updated_at")
  externalCalendars         ExternalCalendar[]
  webhookChannels           CalendarWebhookChannel[]

  @@unique([userId, provider, providerAccountId])
  @@index([userId, provider, status])
  @@map("calendar_connections")
}

model ExternalCalendar {
  id                 String                 @id @default(uuid())
  connectionId       String                 @map("connection_id")
  connection         CalendarConnection     @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  calendarId         String                 @map("calendar_id")
  calendar           Calendar               @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  providerCalendarId String                 @map("provider_calendar_id")
  name               String
  color              String?
  accessRole         String?                @map("access_role")
  selected           Boolean                @default(true)
  syncToken          String?                @map("sync_token")
  lastSyncedAt       DateTime?              @map("last_synced_at")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")
  mappings           ExternalEventMapping[]

  @@unique([connectionId, providerCalendarId])
  @@unique([calendarId])
  @@index([connectionId, selected])
  @@map("external_calendars")
}

model ExternalEventMapping {
  id                 String           @id @default(uuid())
  eventId            String           @map("event_id")
  event              CalendarEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  externalCalendarId String           @map("external_calendar_id")
  externalCalendar   ExternalCalendar @relation(fields: [externalCalendarId], references: [id], onDelete: Cascade)
  providerEventId    String           @map("provider_event_id")
  iCalUid            String?          @map("ical_uid")
  providerEtag       String?          @map("provider_etag")
  providerUpdatedAt  DateTime?        @map("provider_updated_at")
  lastFingerprint    String?          @map("last_fingerprint")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  @@unique([externalCalendarId, providerEventId])
  @@unique([eventId, externalCalendarId])
  @@index([iCalUid])
  @@map("external_event_mappings")
}

model CalendarSyncOutbox {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  eventId     String?   @map("event_id")
  operation   String
  provider    String
  payload     Json?
  status      String    @default("pending")
  attempts    Int       @default(0)
  availableAt DateTime  @default(now()) @map("available_at")
  processedAt DateTime? @map("processed_at")
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([status, availableAt])
  @@index([userId, eventId])
  @@map("calendar_sync_outbox")
}

model CalendarWebhookChannel {
  id                 String             @id
  connectionId       String             @map("connection_id")
  connection         CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  externalCalendarId String             @map("external_calendar_id")
  resourceId         String             @map("resource_id")
  channelToken       String             @map("channel_token")
  expiresAt          DateTime           @map("expires_at")
  createdAt          DateTime           @default(now()) @map("created_at")

  @@index([connectionId, expiresAt])
  @@map("calendar_webhook_channels")
}

model CalendarSubscription {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  label     String    @default("Apple Calendar")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, revokedAt])
  @@map("calendar_subscriptions")
}

model Invoice {
  id                String                     @id @default(uuid())
  userId            String                     @map("user_id")
  user              User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId          String?                    @map("client_id")
  client            Client?                    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectId         String?                    @map("project_id")
  project           Project?                   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  invoiceNumber     String                     @map("invoice_number")
  status            String                     @default("draft")
  currency          String                     @default("USD")
  subtotal          Decimal                    @default(0) @db.Decimal(12, 2)
  taxRate           Decimal                    @default(0) @map("tax_rate") @db.Decimal(5, 2)
  discountRate      Decimal                    @default(0) @map("discount_rate") @db.Decimal(5, 2)
  discountAmount    Decimal                    @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount         Decimal                    @default(0) @map("tax_amount") @db.Decimal(12, 2)
  total             Decimal                    @default(0) @db.Decimal(12, 2)
  issueDate         DateTime                   @default(now()) @map("issue_date")
  dueDate           DateTime?                  @map("due_date")
  paidDate          DateTime?                  @map("paid_date")
  notes             String?
  sentAt            DateTime?                  @map("sent_at")
  reviewedAt        DateTime?                  @map("reviewed_at")
  amountPaid        Decimal                    @default(0) @map("amount_paid") @db.Decimal(12, 2)
  publicTokenHash   String?                    @unique @map("public_token_hash")
  sentSnapshot      Json?                      @map("sent_snapshot")
  sentSnapshotAt    DateTime?                  @map("sent_snapshot_at")
  viewedAt          DateTime?                  @map("viewed_at")
  voidedAt          DateTime?                  @map("voided_at")
  dataOrigin        String?                    @map("data_origin")
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")
  items             InvoiceItem[]
  billingOccurrence ContractBillingOccurrence?
  deliveries        InvoiceDelivery[]
  payments          InvoicePayment[]
  events            InvoiceEvent[]

  @@unique([userId, invoiceNumber], name: "unique_user_invoice_number")
  @@index([userId, createdAt])
  @@index([userId, status, dueDate])
