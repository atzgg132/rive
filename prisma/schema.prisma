  contentHash              String                    @map("content_hash")
  createdByUserId          String                    @map("created_by_user_id")
  createdAt                DateTime                  @default(now()) @map("created_at")
  finalizedAt              DateTime?                 @map("finalized_at")
  signatures               ContractSignature[]
  artifacts                ContractArtifact[]
  comments                 ContractComment[]
  reviewLinks              ContractReviewLink[]
  projectGenerationRecords ProjectGenerationRecord[]

  @@unique([contractId, version])
  @@index([contractId, status])
  @@map("contract_versions")
}

model ContractSigner {
  id               String               @id @default(uuid())
  contractId       String               @map("contract_id")
  contract         Contract             @relation(fields: [contractId], references: [id], onDelete: Cascade)
  userId           String?              @map("user_id")
  user             User?                @relation("ContractSignerUser", fields: [userId], references: [id], onDelete: SetNull)
  clientId         String?              @map("client_id")
  client           Client?              @relation("ContractSignerClient", fields: [clientId], references: [id], onDelete: SetNull)
  role             String
  sequence         Int
  name             String
  email            String
  status           String               @default("pending")
  providerSignerId String?              @map("provider_signer_id")
  invitedAt        DateTime?            @map("invited_at")
  signedAt         DateTime?            @map("signed_at")
  declinedAt       DateTime?            @map("declined_at")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  signatures       ContractSignature[]
  reviewLinks      ContractReviewLink[]

  @@unique([contractId, role])
  @@index([email, status])
  @@map("contract_signers")
}

model ContractSignature {
  id                 String          @id @default(uuid())
  contractId         String          @map("contract_id")
  contract           Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  versionId          String          @map("version_id")
  version            ContractVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  signerId           String          @map("signer_id")
  signer             ContractSigner  @relation(fields: [signerId], references: [id], onDelete: Restrict)
  signerRole         String          @map("signer_role")
  signerName         String          @map("signer_name")
  signerEmail        String          @map("signer_email")
  signatureType      String          @default("typed") @map("signature_type")
  signatureValue     String?         @map("signature_value")
  consentAccepted    Boolean         @map("consent_accepted")
  consentTextVersion String          @map("consent_text_version")
  ipHash             String?         @map("ip_hash")
  userAgentHash      String?         @map("user_agent_hash")
  providerEventId    String?         @map("provider_event_id")
  providerPayload    Json?           @map("provider_payload")
  signedAt           DateTime        @map("signed_at")
  createdAt          DateTime        @default(now()) @map("created_at")

  @@unique([signerId, versionId])
  @@index([contractId, signedAt])
  @@map("contract_signatures")
}

model ContractReviewLink {
  id             String            @id @default(uuid())
  contractId     String            @map("contract_id")
  contract       Contract          @relation(fields: [contractId], references: [id], onDelete: Cascade)
  versionId      String?           @map("version_id")
  version        ContractVersion?  @relation(fields: [versionId], references: [id], onDelete: Cascade)
  signerId       String?           @map("signer_id")
  signer         ContractSigner?   @relation(fields: [signerId], references: [id], onDelete: Cascade)
  tokenHash      String            @unique @map("token_hash")
  type           String            @default("review")
  expiresAt      DateTime          @map("expires_at")
  revokedAt      DateTime?         @map("revoked_at")
  lastAccessedAt DateTime?         @map("last_accessed_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  comments       ContractComment[]

  @@index([contractId, type, revokedAt])
  @@index([versionId, type])
  @@index([expiresAt])
  @@map("contract_review_links")
}

model ContractComment {
  id           String              @id @default(uuid())
  contractId   String              @map("contract_id")
  contract     Contract            @relation(fields: [contractId], references: [id], onDelete: Cascade)
  versionId    String?             @map("version_id")
  version      ContractVersion?    @relation(fields: [versionId], references: [id], onDelete: SetNull)
  reviewLinkId String?             @map("review_link_id")
  reviewLink   ContractReviewLink? @relation(fields: [reviewLinkId], references: [id], onDelete: SetNull)
  authorUserId String?             @map("author_user_id")
  authorUser   User?               @relation("ContractCommentAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  authorRole   String              @map("author_role")
  authorName   String              @map("author_name")
  authorEmail  String?             @map("author_email")
  sectionKey   String?             @map("section_key")
  body         String
  status       String              @default("open")
  resolvedAt   DateTime?           @map("resolved_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  @@index([contractId, status, createdAt])
  @@index([versionId, sectionKey])
  @@map("contract_comments")
}

model ContractEvent {
  id          String   @id @default(uuid())
  contractId  String   @map("contract_id")
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  versionId   String?  @map("version_id")
  actorUserId String?  @map("actor_user_id")
  actorUser   User?    @relation("ContractEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  eventType   String   @map("event_type")
  metadata    Json?
  ipHash      String?  @map("ip_hash")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([contractId, createdAt])
  @@index([eventType, createdAt])
  @@map("contract_events")
}

model ContractArtifact {
  id           String          @id @default(uuid())
  contractId   String          @map("contract_id")
  contract     Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  versionId    String          @map("version_id")
  version      ContractVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  artifactType String          @map("artifact_type")
  mimeType     String          @map("mime_type")
  objectKey    String?         @map("object_key")
  content      Json?
  contentHash  String          @map("content_hash")
  generatedAt  DateTime        @default(now()) @map("generated_at")

  // One artifact per (contract, version, type) — e.g. a single evidence PDF per
  // accepted version. Defense-in-depth: correctness currently rests on the
  // optimistic signing → executed transaction ordering; this makes a duplicate
  // artifact write impossible even if that ordering ever races.
  @@unique([contractId, versionId, artifactType], name: "unique_contract_artifact_per_version_type")
  @@index([contractId, generatedAt])
  @@map("contract_artifacts")
}

model ContractPaymentPlanItem {
  id                 String                     @id @default(uuid())
  contractId         String                     @map("contract_id")
  contract           Contract                   @relation(fields: [contractId], references: [id], onDelete: Cascade)
  milestoneId        String?                    @map("milestone_id")
  milestone          Milestone?                 @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  label              String
  amount             Decimal                    @db.Decimal(12, 2)
  currency           String
  triggerType        String                     @map("trigger_type")
  triggerDate        DateTime?                  @map("trigger_date")
  dueDays            Int                        @default(7) @map("due_days")
  invoiceDescription String?                    @map("invoice_description")
  sequence           Int                        @default(0)
  status             String                     @default("planned")
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")
  occurrence         ContractBillingOccurrence?

  @@index([contractId, status, sequence])
  @@index([milestoneId, triggerType])
  @@map("contract_payment_plan_items")
}

model ContractBillingOccurrence {
  id                String                  @id @default(uuid())
  contractId        String                  @map("contract_id")
  contract          Contract                @relation(fields: [contractId], references: [id], onDelete: Cascade)
  paymentPlanItemId String                  @unique @map("payment_plan_item_id")
  paymentPlanItem   ContractPaymentPlanItem @relation(fields: [paymentPlanItemId], references: [id], onDelete: Cascade)
  invoiceId         String?                 @unique @map("invoice_id")
  invoice           Invoice?                @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  status            String                  @default("pending")
  eligibleAt        DateTime?               @map("eligible_at")
  draftedAt         DateTime?               @map("drafted_at")
  lastError         String?                 @map("last_error")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  @@index([contractId, status, eligibleAt])
  @@map("contract_billing_occurrences")
}

model ProjectGenerationRecord {
  id                 String          @id @default(uuid())
  userId             String          @map("user_id")
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  contractId         String          @map("contract_id")
  contract           Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  acceptedVersionId  String          @map("accepted_version_id")
  acceptedVersion    ContractVersion @relation(fields: [acceptedVersionId], references: [id], onDelete: Cascade)
  status             String          @default("pending")
  previewPlan        Json?           @map("preview_plan")
  previewHash        String?         @map("preview_hash")
  idempotencyKeyHash String?         @map("idempotency_key_hash")
  resultIds          Json?           @map("result_ids")
  error              String?
  previewedAt        DateTime?       @map("previewed_at")
  startedAt          DateTime?       @map("started_at")
  completedAt        DateTime?       @map("completed_at")
  failedAt           DateTime?       @map("failed_at")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  projectId          String?         @map("project_id")
  project            Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([contractId, acceptedVersionId], name: "project_generation_contract_version_key")
  @@index([userId, status, updatedAt])
  @@index([contractId, status])
  @@index([projectId])
  @@map("project_generation_records")
}

model InvoiceDelivery {
  id                String    @id @default(uuid())
  invoiceId         String    @map("invoice_id")
  invoice           Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recipient         String
  channel           String    @default("email")
  status            String
  providerMessageId String?   @map("provider_message_id")
  error             String?
  sentAt            DateTime? @map("sent_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([invoiceId, createdAt])
  @@map("invoice_deliveries")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  href      String?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model RateLimitBucket {
  id        String   @id @default(uuid())
  key       String   @unique
  count     Int
  resetAt   DateTime @map("reset_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([resetAt])
  @@map("rate_limit_buckets")
}
