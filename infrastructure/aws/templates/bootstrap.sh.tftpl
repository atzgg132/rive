#!/bin/bash
set -euo pipefail

REGION="${region}"
REPOSITORY_URL="${repository_url}"
mkdir -p /opt/rive/env /opt/rive/caddy/data /opt/rive/caddy/config

dnf install -y docker jq postgresql15 amazon-cloudwatch-agent cronie

# Bounded local logs are the fallback for every container that does not opt
# into awslogs explicitly (the app and proxy containers do).
cat >/etc/docker/daemon.json <<'JSON'
{
  "log-driver": "json-file",
  "log-opts": {
    "max-size": "10m",
    "max-file": "3"
  }
}
JSON

systemctl enable --now docker
systemctl enable --now crond
usermod -aG docker ec2-user

if ! swapon --show | grep -q /swapfile; then
  dd if=/dev/zero of=/swapfile bs=1M count=2048
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile swap swap defaults 0 0' >> /etc/fstab
fi

# Routing lives in caddy/Caddyfile so the bootstrap and the live host share one
# source. The upstream ports resolve from these variables at proxy start;
# deploy-runtime.sh rewrites this file during a deploy to flip them.
cat >/opt/rive/proxy-upstreams.env <<'EOF'
RIVE_PROD_UPSTREAM=127.0.0.1:3000
RIVE_DEV_UPSTREAM=127.0.0.1:3002
EOF

cat >/opt/rive/Caddyfile <<'CADDY'
${caddyfile}
CADDY

# Host telemetry for the CWAgent alarms (disk/mem/swap as InstanceId-only
# metrics) plus a cron monitor that reports docker restart-count deltas.
cat >/opt/rive/cloudwatch-agent.json <<'JSON'
{
  "agent": {
    "metrics_collection_interval": 60
  },
  "metrics": {
    "append_dimensions": {
      "InstanceId": "$${aws:InstanceId}"
    },
    "metrics_collected": {
      "disk": {
        "measurement": ["used_percent"],
        "resources": ["/"],
        "aggregation_dimensions": [["InstanceId"]]
      },
      "mem": {
        "measurement": ["used_percent"],
        "aggregation_dimensions": [["InstanceId"]]
      },
      "swap": {
        "measurement": ["used_percent"],
        "aggregation_dimensions": [["InstanceId"]]
      }
    }
  }
}
JSON
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config -m ec2 -s -c file:/opt/rive/cloudwatch-agent.json

cat >/opt/rive/container-restart-monitor.sh <<'EOF'
#!/bin/bash
set -uo pipefail
STATE=/opt/rive/restart-monitor.state
touch "$STATE"
TOTAL=0
NEW=""
while read -r NAME; do
  COUNT=$(docker inspect -f '{{.RestartCount}}' "$NAME" 2>/dev/null || echo 0)
  PREV=$(awk -v n="$NAME" '$1==n {print $2}' "$STATE" 2>/dev/null)
  PREV="$${PREV:-0}"
  if [ "$COUNT" -gt "$PREV" ]; then
    TOTAL=$((TOTAL + COUNT - PREV))
  fi
  NEW="$${NEW}$NAME $COUNT\n"
done <<'LIST'
rive-prod
rive-dev
rive-proxy
LIST
printf '%b' "$NEW" >"$STATE"
TOKEN=$(curl -s -m 2 -X PUT -H 'X-aws-ec2-metadata-token-ttl-seconds: 60' http://169.254.169.254/latest/api/token)
IID=$(curl -s -m 2 -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/instance-id)
aws cloudwatch put-metric-data --region "${region}" --namespace Rive/Host \
  --metric-name ContainerRestarts --value "$TOTAL" \
  --dimensions "InstanceId=$IID" >/dev/null 2>&1 || true
EOF
chmod 750 /opt/rive/container-restart-monitor.sh
printf '* * * * * root /opt/rive/container-restart-monitor.sh\n' >/etc/cron.d/rive-restart-monitor

docker rm -f rive-proxy >/dev/null 2>&1 || true
docker run -d \
  --name rive-proxy \
  --restart unless-stopped \
  --network host \
  --env-file /opt/rive/proxy-upstreams.env \
  -v /opt/rive/Caddyfile:/etc/caddy/Caddyfile:ro \
  -v /opt/rive/caddy/data:/data \
  -v /opt/rive/caddy/config:/config \
  --log-driver awslogs \
  --log-opt "awslogs-region=${region}" \
  --log-opt awslogs-group=/rive/proxy \
  --log-opt awslogs-stream=rive-proxy \
  --log-opt awslogs-create-group=true \
  caddy:2.10-alpine

# The deploy contract is repository-owned (scripts/deploy-runtime.sh). The copy
# below is the first-boot fallback; every deploy re-uploads the reviewed
# version, so this only matters until the first pipeline run on a fresh host.
cat >/opt/rive/deploy-runtime.sh <<'DEPLOY'
${deploy_runtime}
DEPLOY
chmod 750 /opt/rive/deploy-runtime.sh

MASTER_SECRET=""
for attempt in $(seq 1 60); do
  if MASTER_SECRET=$(aws secretsmanager get-secret-value \
    --region "$REGION" \
    --secret-id "${db_master_secret}" \
    --query SecretString \
    --output text 2>/dev/null); then
    if pg_isready -h "${db_endpoint}" -p 5432 >/dev/null 2>&1; then
      break
    fi
  fi
  sleep 10
done

MASTER_USER=$(jq -r .username <<<"$MASTER_SECRET")
MASTER_PASSWORD=$(jq -r .password <<<"$MASTER_SECRET")
export PGPASSWORD="$MASTER_PASSWORD"

for ENVIRONMENT in prod dev; do
  DB_USER="rive_$ENVIRONMENT"
  DB_NAME="rive_$ENVIRONMENT"
  DB_PASSWORD=$(aws ssm get-parameter \
    --region "$REGION" \
    --name "/rive/$ENVIRONMENT/DB_PASSWORD" \
    --with-decryption \
    --query Parameter.Value \
    --output text)

  psql -v ON_ERROR_STOP=1 \
    -h "${db_endpoint}" \
    -U "$MASTER_USER" \
    -d rive_admin \
    --set=db_user="$DB_USER" \
    --set=db_password="$DB_PASSWORD" \
    --set=db_name="$DB_NAME" <<'SQL'
SELECT format('CREATE ROLE %I LOGIN PASSWORD %L', :'db_user', :'db_password')
WHERE NOT EXISTS (SELECT FROM pg_catalog.pg_roles WHERE rolname = :'db_user') \gexec
SELECT format('GRANT %I TO %I', :'db_user', current_user) \gexec
SELECT format('CREATE DATABASE %I OWNER %I', :'db_name', :'db_user')
WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = :'db_name') \gexec
SQL
done

unset PGPASSWORD MASTER_PASSWORD MASTER_SECRET
touch /opt/rive/bootstrap-complete
