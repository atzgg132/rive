#!/bin/bash
set -euo pipefail

REGION="${region}"
REPOSITORY_URL="${repository_url}"
mkdir -p /opt/rive/env /opt/rive/caddy/data /opt/rive/caddy/config

dnf install -y docker jq postgresql15
systemctl enable --now docker
usermod -aG docker ec2-user

if ! swapon --show | grep -q /swapfile; then
  dd if=/dev/zero of=/swapfile bs=1M count=2048
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile swap swap defaults 0 0' >> /etc/fstab
fi

cat >/opt/rive/Caddyfile <<'CADDY'
{
  email hello@rive.work
  admin off
}

${prod_hostname} {
  encode zstd gzip
  reverse_proxy 127.0.0.1:3000
}

${dev_hostname} {
  encode zstd gzip
  reverse_proxy 127.0.0.1:3002
}
CADDY

docker rm -f rive-proxy >/dev/null 2>&1 || true
docker run -d \
  --name rive-proxy \
  --restart unless-stopped \
  --network host \
  -v /opt/rive/Caddyfile:/etc/caddy/Caddyfile:ro \
  -v /opt/rive/caddy/data:/data \
  -v /opt/rive/caddy/config:/config \
  caddy:2.10-alpine

cat >/opt/rive/deploy.sh <<'DEPLOY'
#!/bin/bash
set -euo pipefail

ENVIRONMENT="$1"
IMAGE="$2"
REGION="${region}"
REPOSITORY_URL="${repository_url}"

case "$ENVIRONMENT" in
  prod) PORT=3000; MEMORY="${prod_memory}" ;;
  dev) PORT=3002; MEMORY="${dev_memory}" ;;
  *) echo "Unknown environment: $ENVIRONMENT" >&2; exit 2 ;;
esac

ENV_FILE="/opt/rive/env/$ENVIRONMENT.env"
TMP_FILE="$ENV_FILE.tmp"
umask 077
: >"$TMP_FILE"

aws ssm get-parameters-by-path \
  --region "$REGION" \
  --path "/rive/$ENVIRONMENT/" \
  --recursive \
  --with-decryption \
  --output json |
  jq -r '.Parameters[] | select(.Name | endswith("/DB_PASSWORD") | not) | [(.Name | split("/") | last), .Value] | @tsv' |
  while IFS=$'\t' read -r key value; do
    printf '%s=%s\n' "$key" "$value" >>"$TMP_FILE"
  done

printf 'DEPLOYMENT_VERSION=%s\n' "$IMAGE" >>"$TMP_FILE"
mv "$TMP_FILE" "$ENV_FILE"

aws ecr get-login-password --region "$REGION" |
  docker login --username AWS --password-stdin "$${REPOSITORY_URL%%/*}"
docker image prune -af >/dev/null 2>&1 || true
docker pull "$REPOSITORY_URL:$IMAGE"
docker pull "$REPOSITORY_URL:$IMAGE-migrate"

docker run --rm \
  --name "rive-$ENVIRONMENT-migrate" \
  --network host \
  --env-file "$ENV_FILE" \
  "$REPOSITORY_URL:$IMAGE-migrate"

CONTAINER="rive-$ENVIRONMENT"
docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
docker run -d \
  --name "$CONTAINER" \
  --restart unless-stopped \
  --memory "$MEMORY" \
  --stop-timeout 30 \
  -p "127.0.0.1:$PORT:3000" \
  --env-file "$ENV_FILE" \
  "$REPOSITORY_URL:$IMAGE"

for attempt in $(seq 1 30); do
  if curl --fail --silent "http://127.0.0.1:$PORT/api/ready" >/dev/null; then
    docker image prune -f >/dev/null
    echo "$ENVIRONMENT deployed successfully"
    exit 0
  fi
  sleep 2
done

docker logs --tail 100 "$CONTAINER"
exit 1
DEPLOY
chmod 750 /opt/rive/deploy.sh

MASTER_SECRET=""
for attempt in $(seq 1 60); do
  if MASTER_SECRET=$(aws secretsmanager get-secret-value \
    --region "$REGION" \
    --secret-id "${db_master_secret}" \
    --query SecretString \
    --output text 2>/dev/null); then
    if pg_isready -h "${db_endpoint}" -p 5432 >/dev/null 2>&1; then
      break
    fi
  fi
  sleep 10
done

MASTER_USER=$(jq -r .username <<<"$MASTER_SECRET")
MASTER_PASSWORD=$(jq -r .password <<<"$MASTER_SECRET")
export PGPASSWORD="$MASTER_PASSWORD"

for ENVIRONMENT in prod dev; do
  DB_USER="rive_$ENVIRONMENT"
  DB_NAME="rive_$ENVIRONMENT"
  DB_PASSWORD=$(aws ssm get-parameter \
    --region "$REGION" \
    --name "/rive/$ENVIRONMENT/DB_PASSWORD" \
    --with-decryption \
    --query Parameter.Value \
    --output text)

  psql -v ON_ERROR_STOP=1 \
    -h "${db_endpoint}" \
    -U "$MASTER_USER" \
    -d rive_admin \
    --set=db_user="$DB_USER" \
    --set=db_password="$DB_PASSWORD" \
    --set=db_name="$DB_NAME" <<'SQL'
SELECT format('CREATE ROLE %I LOGIN PASSWORD %L', :'db_user', :'db_password')
WHERE NOT EXISTS (SELECT FROM pg_catalog.pg_roles WHERE rolname = :'db_user') \gexec
SELECT format('GRANT %I TO %I', :'db_user', current_user) \gexec
SELECT format('CREATE DATABASE %I OWNER %I', :'db_name', :'db_user')
WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = :'db_name') \gexec
SQL
done

unset PGPASSWORD MASTER_PASSWORD MASTER_SECRET
touch /opt/rive/bootstrap-complete
